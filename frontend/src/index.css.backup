@import '@fontsource-variable/inter';

@tailwind base;
@tailwind components;
@tailwind utilities;

:root {
  --page: #eaf3fd;
  --card: #ffffff;
  --card2: #f3f8ff;
  --line: #cfe2f6;
  --ink: #0b2a5b;
  --muted: #5b7396;
  --soft: #e3effd;
}
.dark {
  --page: #0a1730;
  --card: #0f2147;
  --card2: #0c1c3d;
  --line: #1f3d70;
  --ink: #e8f1ff;
  --muted: #93aad0;
  --soft: #14294f;
}

html { scroll-behavior: smooth; }
body {
  @apply font-sans text-ink antialiased;
  background: #061a3f;
}

@layer components {
  .card { @apply min-w-0 rounded-2xl border border-line bg-card shadow-card; }
  .card-soft { @apply rounded-2xl border border-line bg-card2; }
  .page-title { @apply text-2xl font-extrabold tracking-tight text-ink sm:text-[28px]; }
  .page-sub { @apply mt-1 text-sm text-brand-600 dark:text-brand-300; }
  .panel-title { @apply text-[15px] font-bold text-ink; }
  .btn { @apply inline-flex items-center justify-center gap-2 rounded-xl px-5 py-3 text-sm font-semibold transition focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-400 disabled:cursor-not-allowed disabled:opacity-50; }
  .btn-primary { @apply bg-gradient-to-b from-brand-400 to-brand-600 text-white shadow-btn hover:from-brand-300 hover:to-brand-500; }
  .btn-outline { @apply border border-line bg-card text-ink hover:bg-soft; }
  .chip { @apply inline-flex items-center rounded-md px-2 py-0.5 text-[11px] font-semibold; }
  .th { @apply px-4 py-3 text-left text-xs font-semibold text-muted; }
  .td { @apply px-4 py-3 text-sm; }
}

/* thin scrollbars inside the dark sidebar / tables */
* { scrollbar-width: thin; scrollbar-color: #2a5aa8 transparent; }

@keyframes fadeUp { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
.fade-up { animation: fadeUp .35s ease both; }
@media (prefers-reduced-motion: reduce) { .fade-up { animation: none; } html { scroll-behavior: auto; } }
