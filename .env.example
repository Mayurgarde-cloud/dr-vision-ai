# Copy these placeholders into your process environment and replace the project path.
DR_DATA_DIR=C:/path/to/dr-vision-ai/backend/data/dataset
DR_MODEL_DIR=C:/path/to/dr-vision-ai/backend/models
DR_STORAGE_DIR=C:/path/to/dr-vision-ai/backend/storage
DR_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DR_FRONTEND_DIST=C:/path/to/dr-vision-ai/frontend/dist
DR_TORCH_THREADS=4
# Optional: activate an evaluated experiment bundle without replacing production.
# DR_MODEL_PATH=C:/path/to/dr-vision-ai/backend/models/experiment_svm_v1/dr_model.joblib
# DR_METRICS_PATH=C:/path/to/dr-vision-ai/backend/models/experiment_svm_v1/test_metrics.json
# Optional frontend API URL for separately hosted frontend/backend.
# VITE_API_URL=http://localhost:8000